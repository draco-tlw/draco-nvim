return {
  'huggingface/llm.nvim',
  config = function()
    require('llm').setup {
      backend = 'ollama',
      model = 'qwen2.5-coder:1.5b',
      url = 'http://localhost:11434',

      -- FIM (Fill-in-the-middle) settings for Qwen
      tokens_to_clear = { '<|endoftext|>' },
      request_body = {
        options = {
          temperature = 0.1,
          top_p = 0.9,
          num_predict = 128, -- Keep generation short for speed
        },
      },

      -- Keybindings
      keys = {
        -- Accept the suggestion
        {
          '<Tab>',
          function()
            require('llm').accept()
          end,
          mode = 'i',
          expr = true,
        },
        -- Dismiss the suggestion
        {
          '<Esc>',
          function()
            require('llm').dismiss()
          end,
          mode = 'i',
        },
      },
    }
  end,
}
